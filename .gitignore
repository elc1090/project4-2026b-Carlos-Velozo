*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Configurações de IDEs e Editores
.vscode/
.idea/
*.swp
*~

# Arquivos do Sistema Operacional
.DS_Store
Thumbs.db

# Variáveis de ambiente e segredos
.env
.env.*
!.env.example

# Logs, backups e arquivos temporários
*.log
*.bak
*.tmp
*.orig
*.rej

# Cache de testes e cobertura
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Arquivos locais de desenvolvimento (não fazem parte do projeto)
